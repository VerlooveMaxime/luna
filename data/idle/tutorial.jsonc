// Tutorial Island, stage 0: what a player sees at each step, what the instructors say, and the doors between the
// sections. The rules that move a player from step to step are in game.idle.tutorial.TutorialScript; step names
// are those of game.idle.tutorial.TutorialStep. The text is Jagex's 2006 text as LostCity's 377 scripts have it,
// with Jagex's own line breaks where they gave them; the recap menu and its mentions (a 2012 source) are left out.
{
  // A new character appears here, in the RuneScape Guide's house.
  "start": { "x": 3094, "y": 3106 },

  // Per step: the help box in the chatbox (a title and up to four lines), the yellow arrow (over an npc, over a
  // tile with an edge and a height, or none), the side tabs that appear at that step and stay, and the tab that
  // flashes until the player clicks it.
  "steps": {
    "DESIGN_CHARACTER": {
      "help": {
        "title": "Getting started",
        "lines": [
          "To start the tutorial use your left mouse-button to click",
          "on the 'RuneScape Guide' in this room. He is indicated",
          "by a flashing yellow arrow above his head. If you can't",
          "see him, use your keyboard's arrow keys to rotate the view."
        ]
      },
      "arrow": { "npc": 945 },
      "tabs": ["LOGOUT", "SETTINGS"]
    },
    "TALK_TO_GUIDE": {
      "help": {
        "title": "Getting started",
        "lines": [
          "To start the tutorial use your left mouse-button to click",
          "on the 'RuneScape Guide' in this room. He is indicated",
          "by a flashing yellow arrow above his head. If you can't",
          "see him, use your keyboard's arrow keys to rotate the view."
        ]
      },
      "arrow": { "npc": 945 }
    },
    "OPEN_HOUSE_DOOR": {
      "help": {
        "title": "Interacting with scenery",
        "lines": [
          "You can interact with many items of scenery by simply clicking",
          "on them. Right clicking will also give more options. Try it with",
          "the things in this room, then click on the door indicated with",
          "the yellow arrow to go through to the next instructor."
        ]
      },
      "arrow": { "tile": { "x": 3098, "y": 3107 }, "edge": "WEST", "height": 128 }
    },
    "FIND_SURVIVAL_EXPERT": {
      "help": {
        "title": "Moving around",
        "lines": [
          "Follow the path to find the next instructor. Clicking on the",
          "ground will walk you to that point. Talk to the survival expert by",
          "the pond to continue the tutorial. Remember you can rotate",
          "the view by pressing the arrow keys."
        ]
      },
      "arrow": { "npc": 943 }
    },
    "OPEN_INVENTORY": {
      "help": {
        "title": "Viewing the items that you were given.",
        "lines": [
          "Click on the flashing backpack icon to the right side of the main",
          "window to view your inventory. Your inventory is a list of",
          "everything you have in your backpack."
        ]
      },
      "tabs": ["INVENTORY"],
      "flash": "INVENTORY"
    },
    "CUT_TREE": {
      "help": {
        "title": "Cut down a tree",
        "lines": [
          "You can click on the backpack icon at any time to view",
          "the items you currently have in your inventory. You will see that",
          "you now have an axe in your inventory. Use this to get some logs",
          "by clicking on the indicated tree."
        ]
      },
      "arrow": { "tile": { "x": 3100, "y": 3095 }, "edge": "WEST", "height": 175 }
    },
    "LIGHT_FIRE": {
      "help": {
        "title": "Building a fire",
        "lines": [
          "Well done - you managed to cut some logs from the tree! Next, use",
          "the tinderbox in your inventory to light the logs.",
          "a) First click on the tinderbox to use it.",
          "b) Then click on the logs in your inventory to light them."
        ]
      }
    },
    "OPEN_SKILLS": {
      "help": {
        "title": "",
        "lines": [
          "You gained some experience.",
          "Click on the flashing bar graph icon near the inventory button",
          "to see your skill abilities."
        ]
      },
      "tabs": ["SKILL"],
      "flash": "SKILL"
    },
    // The idle lessons (steps 51-55 and 100-104) are ours: Jagex's island had no autopilot. They build one flow, chop
    // and light, then fish and cook added to it. A step with a goal moves on once the player's autopilot runs a flow
    // with those steps ("chop 1": a chop step with a count of 1) and went round that many times ("laps"), or, with
    // "running": false, once it stopped.
    "TALK_ABOUT_AUTOPILOT": {
      "help": {
        "title": "These are your stats.",
        "lines": [
          "Here you will see how good your skills are. As you move your",
          "mouse over any of the icons in this panel, you can see the exact",
          "amount of experience you have and how much is needed to get",
          "to the next level. Speak to Brynna to continue."
        ]
      },
      "arrow": { "npc": 943 }
    },
    "OPEN_IDLE_TAB": {
      "help": {
        "title": "The autopilot",
        "lines": [
          "Click on the flashing hourglass icon at the bottom left of your",
          "side panel to open the Idle tab. Your autopilot lives here: it",
          "can chop, fish, light and cook for you while you watch."
        ]
      },
      "tabs": ["UNUSED"],
      "flash": "UNUSED"
    },
    "BUILD_FIRST_FLOW": {
      "help": {
        "title": "Your first flow",
        "lines": [
          "Click 'Flow builder'. Click a field to change it. Make a 'chop'",
          "step for 1 'normal' log and click 'Add step', then a 'light' step",
          "for 1 log, and add it too. Click 'Run' near the trees: steps work",
          "around the spot where you click 'Run'."
        ]
      },
      "goal": { "running": true, "steps": ["chop 1", "light 1"] }
    },
    "WATCH_THE_AUTOPILOT": {
      "help": {
        "title": "Watch it work",
        "lines": [
          "The autopilot cuts one log, lights it, and starts the flow over",
          "until you stop it. Watch it go round once. Your skills grow",
          "slower while the autopilot works than when you do it yourself,",
          "but they never stop growing."
        ]
      },
      "goal": { "running": true, "steps": ["chop 1", "light 1"], "laps": 1 }
    },
    "STOP_THE_AUTOPILOT": {
      "help": {
        "title": "Stopping the autopilot",
        "lines": [
          "Well done. Click 'Stop' in the Idle tab or in the flow builder.",
          "Your flow is kept: you can run it again whenever you like.",
          "Then speak to Brynna to continue."
        ]
      },
      "goal": { "running": false }
    },
    "TALK_ABOUT_FOOD": {
      "help": {
        "title": "",
        "lines": [
          "Speak to Brynna to continue."
        ]
      },
      "arrow": { "npc": 943 }
    },
    "CATCH_SHRIMP": {
      "help": {
        "title": "Catch some Shrimp.",
        "lines": [
          "Click on the fishing spot, indicated by the flashing arrow.",
          "Remember you can check your inventory by clicking the",
          "backpack icon."
        ]
      },
      "arrow": { "npc": 952 }
    },
    "COOK_SHRIMP": {
      "help": {
        "title": "Cooking your shrimp.",
        "lines": [
          "Now you have caught some shrimp let's cook it. First light a",
          "fire: Chop down a tree and then use the tinderbox on the logs.",
          "If you've lost your axe or tinderbox Brynna will give you",
          "another."
        ]
      }
    },
    "COOK_AGAIN": {
      "help": {
        "title": "Burning your shrimp.",
        "lines": [
          "You have just burnt your first shrimp. This is normal. As you",
          "get more experience in cooking you will burn stuff less. Let's",
          "try cooking, without burning it this time. First catch some",
          "shrimp, then use them on a fire."
        ]
      }
    },
    "TALK_ABOUT_LOOP": {
      "help": {
        "title": "One more trick",
        "lines": [
          "Before you move on, Brynna has one more thing to show you.",
          "Speak to her."
        ]
      },
      "arrow": { "npc": 943 }
    },
    "EXTEND_THE_FLOW": {
      "help": {
        "title": "Growing your flow",
        "lines": [
          "Open the flow builder. Add a 'fish' step for 1 'shrimp' and click",
          "its 'up' button so it comes before 'light'. Then add a 'cook'",
          "step for 1 at the end, and click 'Run' near the trees and pond."
        ]
      },
      "goal": { "running": true, "steps": ["chop 1", "fish 1", "light 1", "cook 1"] }
    },
    "WATCH_FULL_LOOP": {
      "help": {
        "title": "Round and round",
        "lines": [
          "Each step stops after its one log, shrimp or fire and hands",
          "over to the next. Watch the flow go round once. Shrimp can",
          "still burn: you burn less as your cooking gets better."
        ]
      },
      "goal": { "running": true, "steps": ["chop 1", "fish 1", "light 1", "cook 1"], "laps": 1 }
    },
    "STOP_FULL_LOOP": {
      "help": {
        "title": "Survival on autopilot",
        "lines": [
          "That is all there is to it: any skill, anywhere, one flow.",
          "Click 'Stop' when you have seen enough, then follow the path",
          "to the gate."
        ]
      },
      "goal": { "running": false }
    },
    "LEAVE_SURVIVAL_AREA": {
      "help": {
        "title": "Well done, you've just cooked your first RuneScape meal.",
        "lines": [
          "You can now move onto the next instructor. Follow the path",
          "and click on the gate shown. Remember you can move",
          "the camera with the arrow keys."
        ]
      },
      "arrow": { "tile": { "x": 3089, "y": 3092 }, "edge": "EAST", "height": 100 }
    },
    "FIND_MASTER_CHEF": {
      "help": {
        "title": "Find your next instructor.",
        "lines": [
          "Follow the path until you get to the door with the yellow arrow",
          "above it. Click on the door to open it. Notice the mini-map in",
          "the top right, this shows a top down view of the area around",
          "you. This can also be used for navigation."
        ]
      },
      "arrow": { "tile": { "x": 3078, "y": 3084 }, "edge": "EAST", "height": 150 }
    },
    "TALK_TO_CHEF": {
      "help": {
        "title": "Find your next instructor.",
        "lines": [
          "Talk to the chef indicated. He will teach you the more advanced",
          "aspects of cooking such as combining ingredients. He will also",
          "teach you about your music player menu as well."
        ]
      },
      "arrow": { "npc": 942 }
    },
    // Jagex's lines; the fourth is ours: Luna's dough window offers several doughs, the 2006 island made bread dough
    // straight away.
    "MAKE_DOUGH": {
      "help": {
        "title": "Making dough.",
        "lines": [
          "This is the base for many of the meals. To make dough we must",
          "mix flour and water. So first right click the bucket of water and",
          "select use then left click on the pot of flour. Then choose",
          "'Bread dough' in the window that opens."
        ]
      },
      "goal": { "carries": 2307 }
    },
    "BAKE_BREAD": {
      "help": {
        "title": "",
        "lines": [
          "Cooking dough. Now you have dough made you can cook it. To",
          "cook the dough use it with the range shown by the arrow. If you",
          "lose your dough talk to Lev, he will give you more ingredients."
        ]
      },
      "arrow": { "tile": { "x": 3075, "y": 3081 }, "height": 100 }
    },
    // The chef's idle lesson (162-165) is ours: a flow whose steps have no amount uses up what the player carries.
    "TALK_ABOUT_SUPPLIES": {
      "help": {
        "title": "Baking for later",
        "lines": [
          "Well done, your first loaf of bread! Lev has more flour and",
          "water for you. Speak to him."
        ]
      },
      "arrow": { "npc": 942 }
    },
    "BAKE_ON_AUTOPILOT": {
      "help": {
        "title": "Using it all up",
        "lines": [
          "Open the flow builder and click 'Clear'. Add a 'make' step for",
          "'bread dough' and a 'cook' step, both with the amount 'all', and",
          "click 'Run' near the range."
        ]
      },
      "goal": { "running": true, "steps": ["make all", "cook all"] }
    },
    "WATCH_THE_BAKING": {
      "help": {
        "title": "Watch it bake",
        "lines": [
          "The make step mixes all your flour into dough, then the cook",
          "step bakes every loaf. A step with no amount keeps going until",
          "there is nothing left to use. Watch the flow go round once."
        ]
      },
      "goal": { "running": true, "steps": ["make all", "cook all"], "laps": 1 }
    },
    "STOP_THE_BAKING": {
      "help": {
        "title": "Out of flour",
        "lines": [
          "The flour has run out, so the make step waits for more.",
          "Click 'Stop' to end the flow."
        ]
      },
      "goal": { "running": false }
    },
    "OPEN_MUSIC": {
      "help": {
        "title": "Well done, your first loaf of bread. As you gain experience in",
        "lines": [
          "cooking you will be able to make other things like pies, cakes",
          "and even kebabs. Now you've got the hang of cooking let's",
          "move on. Click on the flashing icon in the bottom right to see",
          "the jukebox."
        ]
      },
      "tabs": ["MUSIC"],
      "flash": "MUSIC"
    },
    "LEAVE_CHEF": {
      "help": {
        "title": "The Music Player.",
        "lines": [
          "From this interface you can control the music that is played.",
          "As you explore the world more of the tunes will become unlocked.",
          "Once you've examined this menu use the next door to continue.",
          "If you need a recap on anything covered here talk to Lev."
        ]
      },
      "arrow": { "tile": { "x": 3072, "y": 3090 }, "edge": "EAST", "height": 150 }
    },
    // The player controls are tab 12, Luna's EMOTE.
    "OPEN_PLAYER_CONTROLS": {
      "help": {
        "title": "It's only a short distance to the next guide.",
        "lines": [
          "",
          "Why not try running there. Start by opening the player",
          "controls, that's the flashing icon of a running man."
        ]
      },
      "tabs": ["EMOTE"],
      "flash": "EMOTE"
    },
    "TURN_RUN_ON": {
      "help": {
        "title": "Running.",
        "lines": [
          "In this menu you will see many options from waving to walking.",
          "At the top of the panel there are two buttons. One is walk the",
          "other one is run. Click on the run button."
        ]
      },
      "goal": { "run": true }
    },
    "FIND_QUEST_GUIDE": {
      "help": {
        "title": "Run to the next guide.",
        "lines": [
          "Now that you have run turned on follow the path, until you",
          "come to the end. You may notice that your energy left goes",
          "down. If this reaches zero you'll stop running. Click on the door",
          "to pass through it."
        ]
      },
      "arrow": { "tile": { "x": 3086, "y": 3126 }, "edge": "SOUTH", "height": 150 }
    },
    "TALK_TO_QUEST_GUIDE": {
      "help": {
        "title": "",
        "lines": [
          "Talk with the Quest Guide Instructor.",
          "",
          "He'll tell you all about quests."
        ]
      },
      "arrow": { "npc": 949 }
    },
    "OPEN_QUEST_JOURNAL": {
      "help": {
        "title": "",
        "lines": [
          "Open the Quest journal.",
          "",
          "Click on the flashing icon next to your inventory."
        ]
      },
      "tabs": ["QUEST"],
      "flash": "QUEST"
    },
    "TALK_ABOUT_QUESTS": {
      "help": {
        "title": "",
        "lines": [
          "Your Quest journal.",
          "This is your quest journal, a list of all the quests in the game.",
          "Talk to the instructor again for an explanation."
        ]
      },
      "arrow": { "npc": 949 }
    },
    "ENTER_MINE": {
      "help": {
        "title": "",
        "lines": [
          "Moving on.",
          "It's time to enter some caves. Click on the ladder to go down to",
          "the next area."
        ]
      },
      "arrow": { "tile": { "x": 3088, "y": 3119 }, "height": 0 }
    },
    // The Mining Instructor's section is next; he does not teach yet.
    "TALK_TO_MINING_INSTRUCTOR": {
      "help": {
        "title": "Mining and smithing.",
        "lines": [
          "Next let's get you a weapon, or more to the point, you can",
          "make your first weapon yourself. Don't panic, the mining",
          "instructor will help you. Talk to him and he'll tell you all",
          "about it."
        ]
      },
      "arrow": { "npc": 948 }
    }
  },

  // Dialogues by name, each a list of boxes. A box is said by the npc being talked to ("npc"), by the player
  // ("player"), or is a plain message ("text"), in one to four lines.
  "dialogues": {
    "guide_welcome": [
      { "npc": ["Greetings! I see you are a new arrival to this land. My", "job is to welcome all the new visitors. So welcome!"] },
      { "npc": ["You have already learnt the first thing needed to", "succeed in this world... Talking to other people!"] },
      { "npc": ["You will find many inhabitants of this world have useful", "things to say to you. By clicking on them with your", "mouse you can talk to them."] },
      { "npc": ["I would also suggest reading through some of the", "supporting information on the website. There you can", "find maps, a bestiary, and much more."] },
      { "npc": ["To continue the tutorial go through that door over", "there, and speak to your first instructor!"] }
    ],
    "guide_again": [
      { "npc": ["Welcome back. You have already learnt the first thing", "needed to succeed in this world: talking to other people!"] },
      { "npc": ["You will find many inhabitants of this world have useful", "things to say to you. By clicking on them, you can talk", "to them."] },
      { "npc": ["To continue the tutorial go through that door over", "there, and speak to your first instructor!"] }
    ],
    "house_door_locked": [
      { "text": ["You need to talk to the 'RuneScape Guide' before you are", "allowed to proceed through this door."] }
    ],
    "survival_welcome": [
      { "npc": ["Hello there newcomer. My name is Brynna. My job is", "to teach you a few survival tips and tricks. First off", "we're going to start with the most basic survival skill of", "all; making a fire."] },
      { "items": [590, 1351], "text": ["The Survival Guide gives you a", "@blu@Tinderbox@bla@", "and a", "@blu@Bronze Hatchet!"] }
    ],
    "survival_inventory": [
      { "npc": ["Hello again. You should take a look at that menu", "before we continue."] }
    ],
    "survival_fire": [
      { "npc": ["Next up you need to make a fire. First, you'll need to", "cut down a tree to get some logs."] }
    ],
    "survival_skills": [
      { "npc": ["Hello again. You should take a look at that menu", "before we continue."] }
    ],
    "survival_autopilot": [
      { "npc": ["Good. Now, a survivor works smart as well as hard. You", "don't have to click every tree yourself: tell your hands", "what to do and they keep at it while your mind wanders."] },
      { "npc": ["We call it the autopilot. You'll find it behind the", "hourglass on your side panel. Open it and I'll show you."] }
    ],
    "survival_autopilot_again": [
      { "npc": ["Your autopilot is behind the hourglass on your side", "panel. Build a flow there and click Run."] }
    ],
    "survival_food": [
      { "npc": ["There's nothing like a good fire to warm the bones.", "Next thing is getting food in our bellies. We'll need", "something to cook. There are shrimp in the pond there.", "So let's catch and cook some."] },
      { "items": [303], "text": ["The Survival Guide gives you a", "@blu@Net!"] }
    ],
    "survival_loop": [
      { "npc": ["A good meal! Now, your flow can do all of that. Each", "step does one thing and hands over to the next, and the", "flow starts over by itself."] },
      { "npc": ["Add a step to catch one shrimp after the chop, and one", "to cook it after the light, so the fire is still burning", "when your shrimp is ready."] }
    ],
    "survival_loop_again": [
      { "npc": ["Chop one log, catch one shrimp, light the log and cook", "the shrimp: four steps, one flow. Click Run when it's", "ready."] }
    ],
    "chef_welcome": [
      { "npc": ["Ah... welcome newcomer. I am Lev, the chef.", "It is here I will teach you how to", "cook food truly fit for a king."] },
      { "player": ["I already know how to cook.", "Brynna taught me just now."] },
      { "npc": ["HA HA HA HA HA HA! You call THAT cooking?", "Some shrimp on an open log fire? Oh no no no... I am", "going to teach you the fine art of cooking bread."] },
      { "npc": ["And no fine meal is complete without good music so", "we'll cover that while you're here too."] },
      { "items": [1929, 1933], "text": ["The Cooking Guide gives you a", "@blu@Bucket of Water@bla@", "and a", "@blu@Pot of Flour!"] }
    ],
    "chef_bread": [
      { "npc": ["Time for you to learn the fine art of cooking bread."] }
    ],
    "chef_gives_flour_and_water": [
      { "items": [1929, 1933], "text": ["The Cooking Guide gives you a", "@blu@Bucket of Water@bla@", "and a", "@blu@Pot of Flour!"] }
    ],
    "chef_gives_flour": [
      { "items": [1933], "text": ["The Cooking Guide gives you a", "@blu@Pot of Flour."] }
    ],
    "chef_gives_water": [
      { "items": [1929], "text": ["The Cooking Guide gives you a", "@blu@Bucket of Water."] }
    ],
    "chef_supplies": [
      { "npc": ["Ha! Not bad for a first loaf. But a real kitchen bakes", "by the dozen, and your autopilot can do the mixing and", "the baking while you watch."] },
      { "npc": ["Take this flour and water. Make bread dough and cook it,", "with no amount on either step: each one keeps going", "until there is nothing left to use."] },
      { "items": [1933, 1929], "text": ["Lev gives you four", "@blu@Pots of Flour@bla@", "and four", "@blu@Buckets of Water!"] }
    ],
    "chef_gives_supplies": [
      { "items": [1933, 1929], "text": ["Lev gives you four more", "@blu@Pots of Flour@bla@", "and four more", "@blu@Buckets of Water!"] }
    ],
    "chef_supplies_again": [
      { "npc": ["Make bread dough, then cook it, with no amount on", "either step. Click Run near the range."] }
    ],
    "chef_hello": [
      { "npc": ["Hello again."] }
    ],
    // LostCity's own line: no source shows this door refusing anyone.
    "quest_door_locked": [
      { "text": ["You should try turning run on before continuing."] }
    ],
    "quest_guide_welcome": [
      { "npc": ["Ah... welcome adventurer. I'm here to tell you all about", "quests. Let's start by opening the quest side panel."] }
    ],
    "quest_guide_open_journal": [
      { "npc": ["Have you not opened that menu yet?"] }
    ],
    "quest_guide_journal": [
      { "npc": ["Now you have the journal open I'll tell you a bit about", "it. As you see at the moment all the quests are shown", "in red, a quest shown in red is unstarted."] }
    ],
    "quest_guide_quests": [
      { "npc": ["When you start a quest it will change colour to yellow,", "and green when you've finished. This is so you can", "easily see what's complete, what's started, and what's left", "to begin."] },
      { "npc": ["The start of quests are easy to find. Look out for the", "star icons on the minimap, like the one you should see", "marking my house."] },
      { "npc": ["The quests themselves can vary greatly from collecting", "beads to hunting down dragons. Generally quests are", "started by talking to a non player character and will", "involve a series of tasks."] }
    ],
    // Ours: stages and resets.
    "quest_guide_stages": [
      { "npc": ["Have a look at the top of your journal too. Here your", "adventure is told in stages, and each stage asks for", "some levels, some items and a quest before it is done."] },
      { "npc": ["Tutorial Island is your first stage. It shows in yellow", "because you have started it but not finished it yet."] },
      { "npc": ["Finishing a stage lets you reset: you start over without", "your experience or your belongings, but you keep your", "quests and the flows you have built, and every reset", "makes you learn a little faster."] },
      { "npc": ["The Magic Instructor at the end of the island will take", "you through your first reset. You have little to lose yet."] }
    ],
    "quest_guide_caves": [
      { "npc": ["There's not a lot more I can tell you about questing.", "You have to experience the thrill of it yourself to fully", "understand. You may find some adventure in the caves", "under my house."] }
    ],
    "quest_guide_not_ready": [
      { "npc": ["I don't think you're ready to go down there yet."] }
    ],
    "chef_exit_locked": [
      { "text": ["You need to finish the Cooking Guide's tasks first."] }
    ],
    "survival_shrimp": [
