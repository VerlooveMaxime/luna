      "name": "Draynor willows",
      "anchor": { "x": 3086, "y": 3233 },
      "radius": 8,
      "trees": ["willow"],
      "bank": { "x": 3091, "y": 3242 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "seers_maples",
      "name": "Seers' Village maples",
      "anchor": { "x": 2728, "y": 3501 },
      "radius": 9,
      "trees": ["maple"],
      "bank": { "x": 2721, "y": 3494 },
