{
  // Places a flow step can run at. A location is a named part of the map with an optional bank and one area per
  // kind of tree that grows there; the player picks the kind in the chop step (`chop willow @draynor`). Later
  // skills add their own tables (rocks, fishing spots) to the same locations.
  //
  //   id       unique, what flows refer to
  //   name     shown to the player
  //   trees    one entry per kind (normal, oak, willow, maple, yew, magic; teak and mahogany have no cuttable
  //            object in Luna yet): the tile the search is centred on (z = floor, 0 by default) and how many tiles
  //            around it to search, 1 to 32
  //   bank     tile of a bank booth the flow's bank steps use from here (optional)
  //   unlock   stage from which the location can be used (0 = from the start)
  //
  // Areas come from `./gradlew treeSurvey`, which reads the cache: anchor as reported, radius the reported one
  // plus 2 so the approach tiles of trees on the edge stay inside the walking search. LocationsDataTest checks
  // every area against the cache (2 trees or more of its kind within the radius) and that the bank tile holds a
  // booth; walking and reach are checked live.
  "locations": [
    {
      "id": "varrock_west",
      "name": "West of Varrock",
      "trees": {
        // Verified 2026-09-29 with the harness: trees (object 1278) at 3171,3444; 3170,3454; 3168,3437; 3168,3434
        // and more to the north-west around 3150-3160, 3450-3460.
        "normal": { "anchor": { "x": 3165, "y": 3445 }, "radius": 15 },
        "oak": { "anchor": { "x": 3177, "y": 3468 }, "radius": 19 }
      },
      // West bank booths stand on x 3186, y 3436 to 3446 (the bot engine's home bank list).
      "bank": { "x": 3186, "y": 3440 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "lumbridge",
      "name": "Lumbridge",
      "trees": {
        "normal": { "anchor": { "x": 3180, "y": 3224 }, "radius": 18 }
      },
      // No bank in this revision: none in the castle on any floor; Draynor and Al Kharid are about 89 tiles away.
      "unlock": { "stage": 0 }
    },
    {
      "id": "draynor",
      "name": "Draynor village",
      "trees": {
        "normal": { "anchor": { "x": 3115, "y": 3243 }, "radius": 20 },
        "oak": { "anchor": { "x": 3115, "y": 3243 }, "radius": 20 },
        "willow": { "anchor": { "x": 3086, "y": 3233 }, "radius": 8 }
      },
      "bank": { "x": 3091, "y": 3242 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "seers",
      "name": "Seers' Village",
      "trees": {
        "maple": { "anchor": { "x": 2728, "y": 3501 }, "radius": 9 },
        "yew": { "anchor": { "x": 2708, "y": 3461 }, "radius": 8 }
      },
      "bank": { "x": 2721, "y": 3494 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "edgeville",
      "name": "Edgeville",
      "trees": {
        "yew": { "anchor": { "x": 3085, "y": 3474 }, "radius": 8 }
      },
      "bank": { "x": 3095, "y": 3489 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "varrock_palace",
      "name": "Varrock Palace",
      "trees": {
        "yew": { "anchor": { "x": 3211, "y": 3502 }, "radius": 12 }
      },
      "bank": { "x": 3186, "y": 3446 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "catherby",
      "name": "Catherby",
      "trees": {
        "yew": { "anchor": { "x": 2761, "y": 3434 }, "radius": 20 }
      },
      "bank": { "x": 2807, "y": 3442 },
      "unlock": { "stage": 0 }
    }
  ]
}
