{
  // Places a flow step can run at. A location is pure geography: where to stand and what is there. The player
  // composes the action (which tree, how many, bank or drop) in the flow; the location keeps the character in one
  // area instead of drifting after the nearest resource.
  //
  //   id       unique, what flows refer to
  //   name     shown to the player
  //   anchor   tile the search is centred on (z = floor, 0 by default)
  //   radius   tiles around the anchor to search, 1 to 32
  //   trees    tree kinds that grow here (normal, oak, willow, maple, yew, magic; teak and mahogany have no
  //            cuttable object in Luna yet)
  //   bank     tile of a bank booth the flow's bank steps use from here (optional)
  //   unlock   stage from which the location can be used (0 = from the start)
  //
  // Spots come from `./gradlew treeSurvey`, which reads the cache: anchor and bank tile as reported, radius the
  // reported one plus 2 so the approach tiles of trees on the edge stay inside the walking search.
  // LocationsDataTest checks every row against the cache (each kind listed has 2 trees or more within the radius,
  // the bank tile holds a booth); walking and reach are checked live.
  "locations": [
    {
      "id": "varrock_west",
      "name": "West of Varrock",
      // Verified 2026-09-29 with the harness: trees (object 1278) at 3171,3444; 3170,3454; 3168,3437; 3168,3434
      // and more to the north-west around 3150-3160, 3450-3460.
      "anchor": { "x": 3165, "y": 3445 },
      "radius": 15,
      "trees": ["normal"],
      // West bank booths stand on x 3186, y 3436 to 3446 (the bot engine's home bank list).
      "bank": { "x": 3186, "y": 3440 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "varrock_west_oaks",
      "name": "Varrock west oaks",
      "anchor": { "x": 3177, "y": 3468 },
      "radius": 19,
      "trees": ["oak", "normal"],
      "bank": { "x": 3186, "y": 3446 },
      "unlock": { "stage": 0 }
    },
    {
      "id": "lumbridge",
      "name": "Lumbridge",
      "anchor": { "x": 3180, "y": 3224 },
      "radius": 18,
      "trees": ["normal"],
      // No bank in this revision: none in the castle on any floor; Draynor and Al Kharid are about 89 tiles away.
      "unlock": { "stage": 0 }
    },
    {
      "id": "draynor_oaks",
      "name": "Draynor oaks",
      "anchor": { "x": 3115, "y": 3243 },
      "radius": 20,
      "trees": ["oak", "normal"],
      "bank": { "x": 3091, "y": 3242 },
      "unlock": { "stage": 0 }
    },
    {
