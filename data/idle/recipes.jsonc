{
  // What a flow's make step can make: `make [<n>] <name>` uses the "use" item on the "on" item, as a player would,
  // and picks the product in the window that opens, if one does. Items by id; the name is in lower case, the
  // product's own item name where it says what it is (this cache calls every unfinished potion "Unfinished potion",
  // so those are named after their herb). RecipesDataTest checks the ids against the cache. Each row is checked live
  // before it goes in.
  //
  //   product  item id of what is made
  //   name     what flows call it
  //   use      item used...
  //   on       ...on this one
  "recipes": [
    // Pot of flour on a bucket of water; Luna's window also offers pitta, pastry and pizza dough.
    { "product": 2307, "name": "bread dough", "use": 1933, "on": 1929 },
    // Vial of water on a clean guam leaf (Herblore 3).
    { "product": 91, "name": "guam potion (unf)", "use": 227, "on": 249 },
    // Knife on logs, 15 shafts a log; Luna's window also offers the shortbow and longbow.
    { "product": 52, "name": "arrow shaft", "use": 946, "on": 1511 }
  ]
}
